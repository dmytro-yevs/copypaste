[Desktop Entry]
Type=Application
Name=CopyPaste
Comment=Encrypted clipboard history
Comment[ru]=Зашифрованная история буфера обмена
Exec=/usr/lib/copypaste/copypaste %U
Icon=com.copypaste.CopyPaste
Terminal=false
Categories=Utility;
StartupNotify=true
MimeType=x-scheme-handler/copypaste;
X-GNOME-Autostart-enabled=true
