FROM fedora:40@sha256:3c86d25fef9d2001712bc3d9b091fc40cf04be4767e48f1aa3b785bf58d300ed

# This image is an isolated source-package builder. It never installs a KWin
# binary on the host or produces a package that replaces the host compositor.
ARG KWIN_FAMILY
RUN case "$KWIN_FAMILY" in \
      6.0) \
        dnf --disablerepo=updates --disablerepo=updates-source \
          --assumeyes --setopt=install_weak_deps=False install \
          dnf-plugins-core fedora-repos rpmdevtools cmake ninja-build git \
          dbus-daemon dbus-tools plasma-workspace-x11 kwin-wayland wl-clipboard \
        && dnf config-manager --set-enabled fedora-source \
        && dnf config-manager --set-disabled updates updates-source \
        ;; \
      6.3) \
        dnf --assumeyes --setopt=install_weak_deps=False install \
          dnf-plugins-core fedora-repos rpmdevtools cmake ninja-build git \
          dbus-daemon dbus-tools plasma-workspace-x11 kwin-wayland wl-clipboard \
        && dnf config-manager --set-enabled fedora-source updates-source \
        ;; \
      *) echo "ERROR: KWIN_FAMILY must be 6.0 or 6.3" >&2; exit 1 ;; \
    esac \
 && dnf builddep --assumeyes --setopt=install_weak_deps=False kwin \
 && dnf clean all

WORKDIR /workspace
