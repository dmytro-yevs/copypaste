{
  "name": "copypaste-e2e",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "xvfb-run -a -s \"-screen 0 1280x900x24\" vitest run",
    "test:dmy-45:verify": "node scripts/verify-dmy-45-tests.mjs",
    "test:dmy-45": "node scripts/verify-dmy-45-tests.mjs --run",
    "test:dmy-45:browser": "xvfb-run -a -s \"-screen 0 1280x900x24\" npm run test:dmy-45 --",
    "test:dmy-45:browser-repeat": "npm run test:dmy-45:browser && npm run test:dmy-45:browser && npm run test:dmy-45:browser",
    "test:headed": "vitest run",
    "test:windows": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/wait-on": "^5.3.4",
    "execa": "^10.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0",
    "webdriverio": "^9.30.0"
  }
}
