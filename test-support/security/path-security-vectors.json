  "artifactContainmentCases": [
    {
      "id": "parent-traversal",
      "kind": "traversal",
      "root": "evidence",
      "entries": ["evidence/accepted.json", "evidence/../outside.json"],
      "expected": "reject"
    },
    {
      "id": "case-collision",
      "kind": "case_collision",
      "root": "evidence",
      "entries": ["evidence/Failure.json", "evidence/failure.json"],
      "expected": "reject"
    },
    {
      "id": "symlinked-parent",
      "kind": "symlink_parent",
      "root": "evidence",
      "entries": ["evidence/link/record.json"],
      "link": { "path": "evidence/link", "target": "../outside" },
      "expected": "reject"
    },
    {
      "id": "symlinked-leaf",
      "kind": "symlink_leaf",
      "root": "evidence",
      "entries": ["evidence/record.json"],
      "link": { "path": "evidence/record.json", "target": "../outside.json" },
      "expected": "reject"
    },
    {
      "id": "hardlink-alias",
      "kind": "hardlink_alias",
      "root": "evidence",
      "entries": ["evidence/first.json", "evidence/alias.json"],
      "sameFile": ["evidence/first.json", "evidence/alias.json"],
      "expected": "reject"
    },
    {
      "id": "duplicate-resolved-file",
      "kind": "duplicate_resolved",
      "root": "evidence",
      "entries": ["evidence/nested/../record.json", "evidence/record.json"],
      "expected": "reject"
    }
  ]
}
