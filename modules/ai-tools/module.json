{
  "schema_version": 6,
  "api_version": 1,
  "id": "copypaste.ai-tools",
  "title": "AI Tools",
  "description": "Connect AI assistants and control what they can see.",
  "version": "0.1.0",
  "app_versions": ">=1.3.0, <2.0.0",
  "supported_platforms": [
    "macos",
    "windows",
    "linux",
    "android"
  ],
  "capabilities": [
    "history_read",
    "clipboard_write",
    "library_write",
    "snippets",
    "synced_records",
    "local_state",
    "prompts",
    "endpoints"
  ],
  "endpoints": [
    {
      "id": "mcp",
      "platforms": [
        "macos",
        "windows",
        "linux"
      ]
    }
  ],
  "commands": [
    {
      "id": "connections",
      "title": "Connected tools",
      "description": "See, limit and revoke connected AI tools."
    },
    {
      "id": "setup",
      "title": "Connect AI tool",
      "description": "Show the MCP settings for your AI tool."
    },
    {
      "id": "activity",
      "title": "View activity",
      "description": "Show what a connected AI tool did.",
      "arguments": [
        {
          "id": "grant",
          "title": "Connection",
          "kind": "text",
          "default": "",
          "required": true
        }
      ],
      "hidden": true
    },
    {
      "id": "set-access",
      "title": "Change access",
      "description": "Allow or stop changes by a connected AI tool.",
      "arguments": [
        {
          "id": "grant",
          "title": "Connection",
          "kind": "text",
          "default": "",
          "required": true
        },
        {
          "id": "write",
          "title": "Allow changes",
          "kind": "boolean",
          "default": false
        }
      ],
      "hidden": true,
      "app_only": true
    },
    {
      "id": "revoke",
      "title": "Revoke",
      "description": "Stop a connected AI tool from using CopyPaste.",
      "arguments": [
        {
          "id": "grant",
          "title": "Connection",
          "kind": "text",
          "default": "",
          "required": true
        }
      ],
      "hidden": true,
      "app_only": true
    },
    {
      "id": "remove",
      "title": "Remove",
      "description": "Forget a revoked AI tool.",
      "arguments": [
        {
          "id": "grant",
          "title": "Connection",
          "kind": "text",
          "default": "",
          "required": true
        }
      ],
      "hidden": true,
      "app_only": true
    }
  ],
  "preferences": [
    {
      "id": "other-devices",
      "title": "Include items from other devices",
      "kind": "boolean",
      "default": true,
      "synced": true
    },
    {
      "id": "excluded-devices",
      "title": "Excluded devices",
      "kind": "device_set",
      "synced": true
    },
    {
      "id": "content-kinds",
      "title": "Content kinds",
      "kind": "choices",
      "options": [
        {
          "id": "text",
          "title": "Text"
        },
        {
          "id": "link",
          "title": "Links"
        },
        {
          "id": "rich-text",
          "title": "Rich text"
        },
        {
          "id": "image",
          "title": "Images"
        },
        {
          "id": "file",
          "title": "File names and sizes"
        }
      ],
      "default": [
        "text",
        "link",
        "rich-text",
        "file"
      ],
      "synced": true
    },
    {
      "id": "excluded-apps",
      "title": "Excluded apps",
      "kind": "source_app_set",
      "synced": true
    },
    {
      "id": "lookback",
      "title": "History window",
      "kind": "choices",
      "options": [
        {
          "id": "day",
          "title": "Last 24 hours"
        },
        {
          "id": "week",
          "title": "Last 7 days"
        },
        {
          "id": "month",
          "title": "Last 30 days"
        },
        {
          "id": "all",
          "title": "All history"
        }
      ],
      "default": [
        "week"
      ],
      "required": true,
      "synced": true
    }
  ],
