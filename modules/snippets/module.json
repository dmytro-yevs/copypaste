{
  "schema_version": 7,
  "api_version": 1,
  "id": "copypaste.snippets",
  "title": "Snippets",
  "description": "Browse, organize and edit snippets and collections.",
  "version": "0.1.0",
  "app_versions": ">=0.1.1, <2.0.0",
  "supported_platforms": [
    "macos",
    "windows",
    "linux",
    "android"
  ],
  "capabilities": [
    "snippets",
    "synced_records",
    "local_state",
    "clipboard_read"
  ],
  "storage": {
    "max_records": 50000,
    "max_value_bytes": 524288,
    "search_fields": [
      "title",
      "abbreviation",
      "text"
    ],
    "keep_conflicts": true
  },
  "surfaces": {
    "settings": {
      "command": "library",
      "icon": "notebook_text"
    },
    "quick_paste": {
      "title": "Snippets",
      "search_command": "search",
      "activate_command": "use",
      "mixed_limit": 5
    },
    "item_actions": [
      {
        "id": "save",
        "title": "Save as snippet",
        "command": "save-item",
        "icon": "file_plus"
      }
    ],
    "tray_actions": [
      {
        "id": "new",
        "title": "New snippet",
        "command": "new"
      }
    ]
  },
  "provides": [
    {
      "service": "snippets",
      "command": "serve"
    }
  ],
  "commands": [
    {
      "id": "library",
      "title": "Snippet library",
      "description": "Browse, organize and edit snippets and collections."
    },
    {
      "id": "new",
      "title": "New snippet",
      "description": "Create snippet"
    },
    {
      "id": "browse",
      "title": "Browse",
      "description": "Show a scope or search of the library.",
