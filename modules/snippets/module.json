        {
          "id": "scope",
          "title": "Scope",
          "kind": "text",
          "default": ""
        },
        {
          "id": "query",
          "title": "Search",
          "kind": "text",
          "default": ""
        },
        {
          "id": "value",
          "title": "Choice",
          "kind": "text",
          "default": ""
