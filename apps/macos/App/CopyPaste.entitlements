<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The App Sandbox is off, and this is load-bearing rather than laziness.

	  The app talks to the clipboard service over a Unix socket at
	  ~/Library/Application Support/com.copypaste.CopyPaste/daemon.sock. A
	  sandboxed process gets a redirected container for that directory, so it
	  would not find the socket — and there is no sandbox exception that grants
	  a Unix domain socket outside the container.

	  Turning this on is therefore not a hardening tweak; it breaks every
	  feature at once. If sandboxing is ever wanted, the service has to move
	  (an XPC service, or a socket in a shared App Group container), and that
	  is a change to the IPC contract in crates/copypaste-ipc, not to this file.
	-->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
