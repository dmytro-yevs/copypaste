<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing is backed up. The manifest sets android:allowBackup="false", so this
  file only exists because `android:fullBackupContent` points at it; it excludes
  everything as a second statement of the same rule.

  The reason is not caution, it is arithmetic: the database is encrypted under a
  key derived from a device secret that is itself wrapped by a non-exportable
  Android Keystore key. Restored onto different hardware, that wrapping key does
  not exist, so the restored database is permanently unreadable. Refusing the
  backup tells the user their history did not come across; allowing it would
  hand them an app that starts up locked.
-->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
