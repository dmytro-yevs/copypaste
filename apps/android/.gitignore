# Build output.
/.gradle/
/build/
/app/build/
/local.properties

# Cross-compiled Rust libraries. Produced by scripts/build-rust.sh, one per
# ABI, and never committed: they are ~5 MB each and are reproducible from the
# crate.
/app/src/main/jniLibs/

# The generated UniFFI bindings. Also build output — regenerating them is the
# thing that keeps the Kotlin and the `.so` in step, and a committed copy is a
# copy that can be stale while looking authoritative.
/app/src/main/java/com/copypaste/ffi/
