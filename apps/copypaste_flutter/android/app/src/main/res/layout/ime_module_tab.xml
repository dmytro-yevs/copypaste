<?xml version="1.0" encoding="utf-8"?>
<!-- Module surface tab body: the module's results, their state, and the form
     that replaces the list while an item's fields are filled in. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ListView
        android:id="@+id/ime_module_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@null"
        android:scrollbarStyle="outsideOverlay" />

    <include layout="@layout/ime_state" />

    <FrameLayout
        android:id="@+id/ime_module_form_slot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/app_color_background"
        android:visibility="gone" />
</FrameLayout>
