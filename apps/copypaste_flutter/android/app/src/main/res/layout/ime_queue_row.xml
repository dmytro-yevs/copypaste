<?xml version="1.0" encoding="utf-8"?>
<!-- One paste-queue entry: a drag handle for reordering, then the shared clip
     row. Screen readers reorder through the row's Move actions instead. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/app_color_background"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/ime_queue_handle"
        android:layout_width="@dimen/app_control_size_touch"
        android:layout_height="@dimen/app_control_size_touch"
        android:importantForAccessibility="no"
        android:padding="@dimen/app_spacing_md"
        android:src="@drawable/ic_lucide_grip_vertical" />

    <include
        layout="@layout/ime_clip_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1" />
</LinearLayout>
