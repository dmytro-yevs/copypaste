<?xml version="1.0" encoding="utf-8"?>
<!-- One Recent clips row: the preview or title (two lines at most) and its
     metadata line. The icon marks masked and pinned rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/app_control_size_touch"
    android:orientation="vertical"
    android:paddingStart="@dimen/app_spacing_sm"
    android:paddingTop="@dimen/app_spacing_xs"
    android:paddingEnd="@dimen/app_spacing_sm"
    android:paddingBottom="@dimen/app_spacing_xs">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_row_icon"
            android:layout_width="@dimen/app_icon_size_sm"
            android:layout_height="@dimen/app_icon_size_sm"
            android:layout_marginEnd="@dimen/app_spacing_xs"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/app_color_card_foreground"
            android:textSize="@dimen/app_text_size_base" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_row_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/app_color_muted_foreground"
        android:textSize="@dimen/app_text_size_history_metadata" />
</LinearLayout>
