<?xml version="1.0" encoding="utf-8"?>
<!-- Recent clips widget: header actions, a capture-paused banner, and either
     the row list or one state message (W7). RemoteViews-safe views only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="@dimen/app_spacing_sm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/app_control_size_large"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_filter"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/app_control_size_compact"
            android:background="@drawable/widget_chip_background"
            android:ellipsize="end"
            android:gravity="center"
            android:paddingStart="@dimen/app_spacing_md"
            android:paddingEnd="@dimen/app_spacing_md"
            android:singleLine="true"
            android:textColor="@color/app_color_secondary_foreground"
            android:textSize="@dimen/app_text_size_small" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/widget_privacy"
            android:layout_width="@dimen/app_control_size_large"
            android:layout_height="@dimen/app_control_size_large"
            android:padding="@dimen/app_spacing_sm"
            android:src="@drawable/ic_lucide_eye" />

        <ImageView
            android:id="@+id/widget_search"
            android:layout_width="@dimen/app_control_size_large"
            android:layout_height="@dimen/app_control_size_large"
            android:contentDescription="@string/widget_search"
            android:padding="@dimen/app_spacing_sm"
            android:src="@drawable/ic_lucide_search" />

        <ImageView
            android:id="@+id/widget_save"
            android:layout_width="@dimen/app_control_size_large"
            android:layout_height="@dimen/app_control_size_large"
            android:contentDescription="@string/quick_access_tile_save_label"
            android:padding="@dimen/app_spacing_sm"
            android:src="@drawable/ic_lucide_clipboard" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/app_spacing_xs"
        android:background="@drawable/widget_banner_background"
        android:padding="@dimen/app_spacing_sm"
        android:text="@string/widget_paused"
        android:textColor="@color/app_color_foreground"
        android:textSize="@dimen/app_text_size_small"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/app_spacing_xs"
        android:layout_weight="1">

        <ListView
            android:id="@+id/widget_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null" />

        <TextView
            android:id="@+id/widget_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="@dimen/app_spacing_md"
            android:textColor="@color/app_color_muted_foreground"
            android:textSize="@dimen/app_text_size_small"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
