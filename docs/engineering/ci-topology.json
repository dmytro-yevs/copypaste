  "linux-native-qualification.yml": {
    "name": "Linux native qualification",
    "triggers": {
      "workflow_call": {
        "inputs": {
          "public_runtime_run_id": {
            "required": false,
            "type": "string",
            "default": ""
          },
          "artifact_run_id": {
            "required": true,
            "type": "string"
          },
          "previous_artifact_run_id": {
            "required": false,
            "type": "string",
            "default": ""
          },
          "supabase_module_run_id": {
            "required": true,
            "type": "string"
          },
          "semantic_search_module_run_id": {
            "required": true,
            "type": "string"
          },
          "ocr_module_run_id": {
            "required": true,
            "type": "string"
          },
          "compositor_runtime_run_id": {
            "required": true,
            "type": "string"
          }
        }
      },
      "workflow_dispatch": {
        "inputs": {
          "artifact_run_id": {
            "description": "Successful production release run containing the exact current Linux packages",
            "required": true,
            "type": "string"
          },
          "previous_artifact_run_id": {
            "description": "Successful earlier production release run; omit only when creating the first-install baseline",
            "required": false,
            "type": "string",
            "default": ""
          },
          "supabase_module_run_id": {
            "description": "Successful unpublished Supabase module workflow run at this exact product commit",
            "required": true,
            "type": "string"
          },
          "semantic_search_module_run_id": {
            "description": "Successful unpublished Semantic Search module workflow run at this exact product commit",
            "required": true,
            "type": "string"
          },
          "ocr_module_run_id": {
            "description": "Successful unpublished OCR module workflow run at this exact product commit",
            "required": true,
            "type": "string"
          },
          "compositor_runtime_run_id": {
            "description": "Successful exact-commit compositor sidecar runtime producer run",
            "required": true,
            "type": "string"
          }
        }
      }
    },
    "jobs": {
      "source": {
        "name": "Verify exact artifact sources",
        "needs": [],
        "workflow": null,
        "condition": null,
        "runner": "ubuntu-24.04",
        "matrix": null
      },
      "scenario": {
        "name": "${{ matrix.architecture }} ${{ matrix.desktop }} ${{ matrix.session }}",
        "needs": [
          "source"
        ],
        "workflow": null,
        "condition": null,
        "runner": "${{ matrix.runner }}",
        "matrix": {
          "include": [
            {
              "architecture": "x86_64",
              "runner": "ubuntu-24.04",
              "desktop": "GNOME",
              "session": "x11",
              "compositor_artifact": "copypaste-compositor-runtime-gnome-46-ubuntu24.04-x86_64"
            }
          ]
        }
      },
      "evidence": {
        "name": "Assemble verified Linux native qualification",
        "needs": [
          "source",
          "scenario"
        ],
        "workflow": null,
        "condition": "${{ needs.scenario.result == 'success' }}",
        "runner": "ubuntu-24.04",
        "matrix": null
      }
    }
  },
