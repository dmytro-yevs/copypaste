  "compositor-runtime.yml": {
    "name": "Compositor runtime producer",
    "triggers": {
      "workflow_dispatch": {
        "inputs": {
          "version": {
            "description": "Stable CopyPaste version for immutable companion package names",
            "required": true,
            "type": "string"
          },
          "commit": {
            "description": "Exact source commit to build",
            "required": true,
            "type": "string"
          },
          "source_run_id": {
            "description": "Release run that requested these source artifacts",
            "required": true,
            "type": "string"
          }
        }
      },
      "workflow_call": {
        "inputs": {
          "version": {
            "required": true,
            "type": "string"
          },
          "commit": {
            "required": true,
            "type": "string"
          },
          "source_run_id": {
            "required": true,
            "type": "string"
          }
        },
        "secrets": {
          "TAURI_SIGNING_PRIVATE_KEY": {
            "required": true
          },
          "TAURI_SIGNING_PRIVATE_KEY_PASSWORD": {
            "required": true
          }
        }
      }
    },
    "jobs": {
      "build": {
        "name": "${{ matrix.desktop }} ${{ matrix.family }} ${{ matrix.distribution }} (${{ matrix.architecture }})",
        "needs": [],
        "workflow": null,
        "condition": null,
        "runner": "${{ matrix.runner }}",
        "matrix": {
          "include": [
            {
              "desktop": "GNOME",
              "family": "46",
              "distribution": "Ubuntu 24.04",
              "distribution_id": "ubuntu",
              "distribution_version": "24.04",
              "architecture": "x86_64",
              "runner": "ubuntu-24.04",
              "package_format": "deb",
              "artifact": "copypaste-compositor-runtime-gnome-46-ubuntu24.04-x86_64",
              "platform": "linux/amd64"
            }
          ]
        }
      }
    }
  },
