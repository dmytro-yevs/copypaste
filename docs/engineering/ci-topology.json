  "release.yml": {
    "name": "Production release",
    "triggers": {
      "workflow_dispatch": {
        "inputs": {
          "publish": {
            "description": "Publish the already-tagged, qualified stable release",
            "required": true,
            "type": "boolean",
            "default": false
          },
          "qualified_run_id": {
            "description": "Optional exact-tag publication recovery source; qualified runs are discovered automatically",
            "required": false,
            "type": "string",
            "default": ""
          },
          "linux_evidence_run_id": {
            "description": "Run containing exact-artifact Linux native qualification evidence",
            "required": false,
            "type": "string",
            "default": ""
          },
          "linux_artifact_run_id": {
            "description": "Prior release run with exact signed Linux artifacts for this tag",
            "required": false,
            "type": "string",
            "default": ""
          },
          "compositor_runtime_run_id": {
            "description": "Completed exact-source compositor runtime producer run for an explicit staging release",
            "required": false,
            "type": "string",
            "default": ""
          },
          "linux_qualification_only": {
            "description": "Run only the exact Linux native qualification against completed staging inputs",
            "required": false,
            "type": "boolean",
            "default": false
          },
          "supabase_module_run_id": {
            "description": "Completed exact-source unpublished Supabase module run",
            "required": false,
            "type": "string",
            "default": ""
          },
          "semantic_search_module_run_id": {
            "description": "Completed exact-source unpublished Semantic Search module run",
            "required": false,
            "type": "string",
            "default": ""
          },
          "ocr_module_run_id": {
            "description": "Completed exact-source unpublished OCR module run",
            "required": false,
            "type": "string",
            "default": ""
          },
          "previous_linux_artifact_run_id": {
            "description": "Completed earlier Linux staging run used by prior-release qualification evidence",
            "required": false,
            "type": "string",
            "default": ""
          }
        }
      },
      "push": {
        "tags": [
          "v*"
        ]
      }
    },
    "jobs": {
      "preflight": {
        "name": "preflight",
        "needs": [],
        "workflow": null,
        "condition": null,
        "runner": "ubuntu-24.04",
        "matrix": null
      },
      "linux-native-bootstrap": {
        "name": "Run exact staged Linux native qualification",
        "needs": [
          "preflight"
        ],
        "workflow": "./.github/workflows/linux-native-qualification.yml",
        "condition": "needs.preflight.outputs.linux_qualification_only == 'true'",
        "runner": null,
        "matrix": null
      },
      "qualification-supabase": {
        "name": "Build Linux supabase module",
        "needs": [
          "preflight"
        ],
        "workflow": "./.github/workflows/provider-module.yml",
        "condition": "needs.preflight.outputs.reuse_qualified != 'true' && needs.preflight.outputs.linux_qualification_only != 'true' && needs.preflight.outputs.linux_required == 'true' && inputs.linux_evidence_run_id == '' && inputs.supabase_module_run_id == ''",
        "runner": null,
        "matrix": null
      },
      "qualification-semantic-search": {
        "name": "Build Linux semantic-search module",
        "needs": [
          "preflight"
        ],
        "workflow": "./.github/workflows/provider-module.yml",
        "condition": "needs.preflight.outputs.reuse_qualified != 'true' && needs.preflight.outputs.linux_qualification_only != 'true' && needs.preflight.outputs.linux_required == 'true' && inputs.linux_evidence_run_id == '' && inputs.semantic_search_module_run_id == ''",
        "runner": null,
        "matrix": null
      },
      "qualification-ocr": {
        "name": "Build Linux ocr module",
        "needs": [
          "preflight"
        ],
        "workflow": "./.github/workflows/ocr-module.yml",
        "condition": "needs.preflight.outputs.reuse_qualified != 'true' && needs.preflight.outputs.linux_qualification_only != 'true' && needs.preflight.outputs.linux_required == 'true' && inputs.linux_evidence_run_id == '' && inputs.ocr_module_run_id == ''",
        "runner": null,
        "matrix": null
      },
      "linux-native-current": {
        "name": "Qualify current Linux artifacts",
        "needs": [
          "preflight",
          "linux",
          "compositor-runtime-public",
          "qualification-supabase",
          "qualification-semantic-search",
          "qualification-ocr"
        ],
        "workflow": "./.github/workflows/linux-native-qualification.yml",
        "condition": "${{ always() && needs.preflight.result == 'success' && needs.preflight.outputs.reuse_qualified != 'true' && needs.preflight.outputs.linux_qualification_only != 'true' && needs.preflight.outputs.linux_required == 'true' && inputs.linux_evidence_run_id == '' && (needs.linux.result == 'success' || inputs.linux_artifact_run_id != '') && needs.compositor-runtime-public.result == 'success' && (needs.qualification-supabase.result == 'success' || inputs.supabase_module_run_id != '') && (needs.qualification-semantic-search.result == 'success' || inputs.semantic_search_module_run_id != '') && (needs.qualification-ocr.result == 'success' || inputs.ocr_module_run_id != '') }}",
        "runner": null,
        "matrix": null
      },
      "macos": {
        "name": "macos",
        "needs": [
          "preflight"
        ],
        "workflow": null,
        "condition": "needs.preflight.outputs.reuse_qualified != 'true' && needs.preflight.outputs.linux_qualification_only != 'true'",
        "runner": "macos-14",
        "matrix": null
      },
      "macos-regression": {
        "name": "macos-regression",
        "needs": [
          "preflight"
        ],
        "workflow": null,
        "condition": "needs.preflight.outputs.reuse_qualified != 'true' && needs.preflight.outputs.linux_qualification_only != 'true'",
        "runner": "macos-14",
        "matrix": null
      },
      "android": {
        "name": "android",
        "needs": [
          "preflight"
        ],
        "workflow": null,
        "condition": "needs.preflight.outputs.reuse_qualified != 'true' && needs.preflight.outputs.linux_qualification_only != 'true'",
        "runner": "ubuntu-24.04",
        "matrix": null
      },
      "windows": {
        "name": "windows",
        "needs": [
          "preflight"
        ],
        "workflow": null,
        "condition": "needs.preflight.outputs.reuse_qualified != 'true' && needs.preflight.outputs.linux_qualification_only != 'true'",
        "runner": "windows-2022",
        "matrix": null
      },
      "linux": {
        "name": "Linux build (${{ matrix.architecture }})",
        "needs": [
          "preflight"
        ],
        "workflow": null,
        "condition": "needs.preflight.outputs.reuse_qualified != 'true' && needs.preflight.outputs.linux_qualification_only != 'true' && needs.preflight.outputs.linux_required == 'true' && needs.preflight.outputs.linux_artifact_run_id == github.run_id",
        "runner": "${{ matrix.runner }}",
        "matrix": {
          "include": [
            {
              "architecture": "x86_64",
              "runner": "ubuntu-24.04",
              "appimagetool_url": "https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-x86_64.AppImage",
              "appimagetool_sha256": "95cbe7cce9717fce90c484e34052ee7c7f1d7635b33c12525b4776826a7d29b6"
            }
          ]
        }
      },
      "compositor-runtime-build": {
        "name": "Build opt-in compositor runtime companions",
        "needs": [
          "preflight"
        ],
        "workflow": "./.github/workflows/compositor-runtime.yml",
        "condition": "needs.preflight.outputs.reuse_qualified != 'true' && needs.preflight.outputs.linux_qualification_only != 'true' && needs.preflight.outputs.compositor_runtime_required == 'true' && inputs.compositor_runtime_run_id == ''",
        "runner": null,
        "matrix": null
      },
      "compositor-runtime-external": {
        "name": "Verify staged compositor runtime companions",
        "needs": [
          "preflight"
        ],
        "workflow": null,
        "condition": "needs.preflight.outputs.reuse_qualified != 'true' && needs.preflight.outputs.linux_qualification_only != 'true' && needs.preflight.outputs.compositor_runtime_required == 'true' && inputs.compositor_runtime_run_id != ''",
        "runner": "ubuntu-24.04",
        "matrix": null
      },
      "compositor-runtime-public": {
        "name": "Sign and bind opt-in compositor runtime companions",
        "needs": [
          "preflight",
          "compositor-runtime-build",
          "compositor-runtime-external"
        ],
        "workflow": null,
        "condition": "${{ always() && needs.preflight.result == 'success' && needs.preflight.outputs.reuse_qualified != 'true' && needs.preflight.outputs.linux_qualification_only != 'true' && needs.preflight.outputs.compositor_runtime_required == 'true' && (needs.compositor-runtime-build.result == 'success' || needs.compositor-runtime-external.result == 'success') }}",
        "runner": "ubuntu-24.04",
        "matrix": null
      },
      "linux-full-parity-evidence": {
        "name": "Linux full parity evidence gate",
        "needs": [
          "preflight",
          "linux",
          "compositor-runtime-public",
          "linux-native-current"
        ],
        "workflow": null,
        "condition": "${{ always() && needs.preflight.result == 'success' && needs.preflight.outputs.reuse_qualified != 'true' && needs.preflight.outputs.linux_qualification_only != 'true' && (needs.linux-native-current.result == 'success' || inputs.linux_evidence_run_id != '') && needs.preflight.outputs.linux_required == 'true' && (needs.linux.result == 'success' || needs.preflight.outputs.linux_artifact_run_id != github.run_id) && (needs.preflight.outputs.compositor_runtime_required != 'true' || needs.compositor-runtime-public.result == 'success') }}",
        "runner": "ubuntu-24.04",
        "matrix": null
      },
      "qualify": {
        "name": "qualify",
        "needs": [
          "preflight",
          "macos",
          "macos-regression",
          "android",
          "windows",
          "linux",
          "compositor-runtime-public",
          "linux-full-parity-evidence"
        ],
        "workflow": null,
        "condition": "${{ always() && needs.preflight.result == 'success' && (needs.preflight.outputs.reuse_qualified == 'true' || (needs.macos.result == 'success' && needs.macos-regression.result == 'success' && needs.android.result == 'success' && needs.windows.result == 'success' && (needs.preflight.outputs.linux_required != 'true' || ((needs.linux.result == 'success' || needs.preflight.outputs.linux_artifact_run_id != github.run_id) && needs.linux-full-parity-evidence.result == 'success' && (needs.preflight.outputs.compositor_runtime_required != 'true' || needs.compositor-runtime-public.result == 'success'))))) }}",
        "runner": "ubuntu-24.04",
        "matrix": null
      },
      "publish": {
        "name": "publish",
        "needs": [
          "preflight",
          "qualify"
        ],
        "workflow": null,
        "condition": "${{ always() && needs.preflight.result == 'success' && needs.qualify.result == 'success' && needs.preflight.outputs.publish == 'true' }}",
        "runner": "ubuntu-24.04",
        "matrix": null
      },
      "release-required": {
        "name": "Release qualification required",
        "needs": [
          "preflight",
          "qualify",
          "linux-native-bootstrap"
        ],
        "workflow": null,
        "condition": "${{ always() }}",
        "runner": "ubuntu-24.04",
        "matrix": null
      }
    }
  },
