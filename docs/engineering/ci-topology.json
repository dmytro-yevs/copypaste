  "ocr-module.yml": {
    "name": "Build and publish OCR module",
    "triggers": {
      "workflow_call": {
        "inputs": {
          "linux_only": {
            "required": false,
            "type": "boolean",
            "default": false
          },
          "publish": {
            "required": false,
            "type": "boolean",
            "default": false
          },
          "publish_marketplace": {
            "required": false,
            "type": "boolean",
            "default": false
          }
        },
        "secrets": {
          "TAURI_SIGNING_PRIVATE_KEY": {
            "required": true
          },
          "TAURI_SIGNING_PRIVATE_KEY_PASSWORD": {
            "required": true
          }
        }
      },
      "workflow_dispatch": {
        "inputs": {
          "publish": {
            "description": "Publish qualified packages and update the signed marketplace",
            "required": true,
            "type": "boolean",
            "default": false
          },
          "publish_marketplace": {
            "description": "Update the marketplace after publishing packages; defer during an application release",
            "required": false,
            "type": "boolean",
            "default": true
          }
        }
      }
    },
    "jobs": {
      "preflight": {
        "name": "preflight",
        "needs": [],
        "workflow": null,
        "condition": null,
        "runner": "ubuntu-24.04",
        "matrix": null
      },
      "desktop": {
        "name": "desktop",
        "needs": [
          "preflight"
        ],
        "workflow": null,
        "condition": null,
        "runner": "${{ matrix.runner }}",
        "matrix": {
          "include": "${{ fromJSON(needs.preflight.outputs.desktop_matrix) }}"
        }
      },
      "android": {
        "name": "android",
        "needs": [
          "preflight"
        ],
        "workflow": null,
        "condition": "inputs.linux_only != true",
        "runner": "ubuntu-24.04",
        "matrix": {
          "include": [
            {
              "architecture": "arm",
              "target": "armv7-linux-androideabi"
            },
            {
              "architecture": "aarch64",
              "target": "aarch64-linux-android"
            },
            {
              "architecture": "x86_64",
              "target": "x86_64-linux-android"
            }
          ]
        }
      },
      "android-native": {
        "name": "android-native",
        "needs": [
          "preflight",
          "android"
        ],
        "workflow": null,
        "condition": null,
        "runner": "ubuntu-24.04",
        "matrix": null
      },
      "publish": {
        "name": "publish",
        "needs": [
          "preflight",
          "desktop",
          "android",
          "android-native"
        ],
        "workflow": null,
        "condition": "inputs.publish",
        "runner": "ubuntu-24.04",
        "matrix": null
      }
    }
  },
  "provider-module.yml": {
    "name": "Build and publish provider module",
    "triggers": {
      "workflow_call": {
        "inputs": {
          "module": {
            "required": true,
            "type": "string"
          },
          "linux_only": {
            "required": false,
            "type": "boolean",
            "default": false
          },
          "publish": {
            "required": false,
            "type": "boolean",
            "default": false
          },
          "publish_marketplace": {
            "required": false,
            "type": "boolean",
            "default": false
          }
        },
        "secrets": {
          "TAURI_SIGNING_PRIVATE_KEY": {
            "required": true
          },
          "TAURI_SIGNING_PRIVATE_KEY_PASSWORD": {
            "required": true
          }
        }
      },
      "workflow_dispatch": {
        "inputs": {
          "module": {
            "description": "First-party module to publish",
            "required": true,
            "type": "choice",
            "options": [
              "supabase",
              "semantic-search"
            ]
          },
          "publish": {
            "description": "Publish qualified packages and update the signed marketplace",
            "required": true,
            "type": "boolean",
            "default": false
          },
          "publish_marketplace": {
            "description": "Update the marketplace after publishing packages; defer during an application release",
            "required": false,
            "type": "boolean",
            "default": true
          }
        }
      }
    },
