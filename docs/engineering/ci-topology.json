  "ci.yml": {
    "name": "CI",
    "triggers": {
      "push": {
        "branches": [
          "main"
        ]
      },
      "pull_request": null,
      "merge_group": {
        "types": [
          "checks_requested"
        ]
      }
    },
    "jobs": {
      "changes": {
        "name": "Select required validation",
        "needs": [],
        "workflow": null,
        "condition": null,
        "runner": "ubuntu-24.04",
        "matrix": null
      },
      "compositor-runtime-metadata": {
        "name": "Compositor runtime metadata",
        "needs": [
          "changes"
        ],
        "workflow": null,
        "condition": "needs.changes.outputs.native == 'true' && (github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name == github.repository)",
        "runner": "ubuntu-24.04",
        "matrix": null
      },
      "compositor-runtime-producer": {
        "name": "Compositor runtime producer",
        "needs": [
          "changes",
          "compositor-runtime-metadata"
        ],
        "workflow": "./.github/workflows/compositor-runtime.yml",
        "condition": "needs.changes.outputs.native == 'true' && (github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name == github.repository && needs.compositor-runtime-metadata.result == 'success')",
        "runner": null,
        "matrix": null
      },
      "rust-and-supabase": {
        "name": "rust-and-supabase",
        "needs": [
          "changes"
        ],
        "workflow": null,
        "condition": "needs.changes.outputs.native == 'true'",
        "runner": "ubuntu-24.04",
        "matrix": null
      },
      "macos-core": {
        "name": "macOS Rust capabilities",
        "needs": [
          "changes"
        ],
        "workflow": null,
        "condition": "needs.changes.outputs.native == 'true'",
        "runner": "macos-14",
        "matrix": null
      },
      "windows-core": {
        "name": "Windows Rust capabilities",
        "needs": [
          "changes"
        ],
        "workflow": null,
        "condition": "needs.changes.outputs.native == 'true'",
        "runner": "windows-2022",
        "matrix": null
      },
      "optional-modules": {
        "name": "Optional modules (${{ matrix.name }})",
        "needs": [
          "changes"
        ],
        "workflow": null,
        "condition": "needs.changes.outputs.native == 'true'",
        "runner": "${{ matrix.runner }}",
        "matrix": {
          "include": [
            {
              "name": "macos",
              "platform": "macos",
              "runner": "macos-14"
            },
            {
              "name": "windows",
              "platform": "windows",
              "runner": "windows-2022"
            },
            {
              "name": "Linux x86_64",
              "platform": "linux",
              "runner": "ubuntu-24.04"
            }
          ]
        }
      },
      "flutter-static": {
        "name": "Flutter static checks",
        "needs": [
          "changes"
        ],
        "workflow": null,
        "condition": "needs.changes.outputs.native == 'true'",
        "runner": "ubuntu-24.04",
        "matrix": null
      },
      "flutter-foundation": {
        "name": "Flutter foundation (${{ matrix.name }})",
        "needs": [
          "changes"
        ],
        "workflow": null,
        "condition": "needs.changes.outputs.native == 'true'",
        "runner": "${{ matrix.runner }}",
        "matrix": {
          "include": [
            {
              "name": "macos",
              "platform": "macos",
              "runner": "macos-14",
              "target": "macos"
            },
            {
              "name": "android",
              "platform": "android",
              "runner": "ubuntu-24.04",
              "target": "apk"
            },
            {
              "name": "windows",
              "platform": "windows",
              "runner": "windows-2022",
              "target": "windows"
            },
            {
              "name": "Linux x86_64",
              "platform": "linux",
              "runner": "ubuntu-24.04",
              "target": "linux"
            }
          ]
        }
      },
      "linux-native-fixtures": {
        "name": "Linux native fixtures (${{ matrix.architecture }})",
        "needs": [
          "changes"
        ],
        "workflow": null,
        "condition": "needs.changes.outputs.native == 'true'",
        "runner": "${{ matrix.runner }}",
        "matrix": {
          "include": [
            {
              "architecture": "x86_64",
              "runner": "ubuntu-24.04"
            }
          ]
        }
      },
      "linux-mutter-bridges": {
        "name": "Mutter ${{ matrix.mutter }} bridge (${{ matrix.architecture }})",
        "needs": [
          "changes"
        ],
        "workflow": null,
        "condition": "needs.changes.outputs.native == 'true'",
        "runner": "${{ matrix.runner }}",
        "matrix": {
          "mutter": [
            46
          ],
          "architecture": [
            "x86_64"
          ],
          "include": [
            {
              "architecture": "x86_64",
              "runner": "ubuntu-24.04"
            }
          ]
        }
      },
      "linux-pr-release-candidate": {
        "name": "Linux release candidate (${{ matrix.architecture }})",
        "needs": [
          "changes"
        ],
        "workflow": null,
        "condition": "needs.changes.outputs.native == 'true' && (github.event_name == 'pull_request')",
        "runner": "${{ matrix.runner }}",
        "matrix": {
          "include": [
            {
              "architecture": "x86_64",
              "runner": "ubuntu-24.04",
              "appimagetool_url": "https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-x86_64.AppImage",
              "appimagetool_sha256": "95cbe7cce9717fce90c484e34052ee7c7f1d7635b33c12525b4776826a7d29b6"
            }
          ]
        }
      },
      "linux-package-fixtures": {
        "name": "Linux package fixtures (${{ matrix.architecture }})",
        "needs": [
          "changes"
        ],
        "workflow": null,
        "condition": "needs.changes.outputs.native == 'true'",
        "runner": "${{ matrix.runner }}",
        "matrix": {
          "include": [
            {
              "architecture": "x86_64",
              "runner": "ubuntu-24.04"
            }
          ]
        }
      },
      "required": {
        "name": "CI required",
        "needs": [
          "changes",
          "flutter-static",
          "compositor-runtime-metadata",
          "compositor-runtime-producer",
          "rust-and-supabase",
          "macos-core",
          "windows-core",
          "optional-modules",
          "flutter-foundation",
          "linux-native-fixtures",
          "linux-mutter-bridges",
          "linux-pr-release-candidate",
          "linux-package-fixtures"
        ],
        "workflow": null,
        "condition": "${{ always() }}",
        "runner": "ubuntu-24.04",
        "matrix": null
      }
    }
  },
