    },
    "r-chip": {
      "$value": "7px",
      "$description": "Chip / small tile."
    },
    "r-ctl": {
      "$value": "8px",
      "$description": "Buttons and segmented controls."
    },
    "r-input": {
      "$value": "9px",
      "$description": "Text fields."
    },
    "r-row": {
      "$value": "10px",
      "$description": "History row."
    },
    "r-window": {
      "$value": "12px",
      "$description": "Popup window corner."
    },
    "r-card": {
      "$value": "13px",
      "$description": "Card."
    },
    "r-empty-ic": {
      "$value": "16px",
      "$description": "Empty-state icon plate."
    },
    "r-pill": {
