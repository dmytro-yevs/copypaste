{
  "elevation": {
    "$description": "Light shadow ramp: the same Tailwind v4 geometry as dark at Tailwind's own alphas. A light surface needs a hint of depth, not a hole.",
    "$type": "shadow",
    "sh1": {
      "$value": {
        "color": "oklch(0 0 0 / 0.05)",
        "offsetX": "0",
        "offsetY": "1px",
        "blur": "2px"
      },
      "$description": "Tailwind `shadow-xs`."
    },
    "sh2": {
      "$value": {
        "color": "oklch(0 0 0 / 0.1)",
        "offsetX": "0",
        "offsetY": "4px",
        "blur": "12px",
        "spread": "-2px"
      },
      "$description": "Tailwind `shadow-md`."
    },
    "sh3": {
      "$value": {
        "color": "oklch(0 0 0 / 0.15)",
        "offsetX": "0",
        "offsetY": "20px",
        "blur": "40px",
        "spread": "-12px"
      },
      "$description": "Tailwind `shadow-xl`."
    }
  }
}
