{
  "type": {
    "$description": "Type scale (port-manifest §8.5). The font-size ladder is deliberately dense and includes half-pixel steps — CopyPaste is an information-dense list app and those halves are what keeps a 74px row readable. Do not round them.",
    "f-ui": {
      "$type": "fontFamily",
      "$value": [
        "Inter",
        "-apple-system",
        "BlinkMacSystemFont",
        "Segoe UI Variable",
        "Segoe UI",
        "system-ui",
        "sans-serif"
      ],
      "$description": "UI face. Android resolves this to Inter with the platform sans fallback."
    },
    "f-mono": {
      "$type": "fontFamily",
      "$value": [
        "JetBrains Mono",
        "ui-monospace",
        "SF Mono",
        "Cascadia Mono",
        "Roboto Mono",
        "Menlo",
        "monospace"
      ],
      "$description": "Monospace face. §8.7: the code, json, num and color content kinds render in it."
    },
    "fs-3xs": {
      "$type": "dimension",
      "$value": "9.5px"
    },
    "fs-2xs": {
      "$type": "dimension",
      "$value": "10px"
    },
    "fs-xs": {
      "$type": "dimension",
      "$value": "11px"
    },
    "fs-sm": {
      "$type": "dimension",
      "$value": "11.5px"
    },
    "fs-smd": {
      "$type": "dimension",
      "$value": "12px"
    },
    "fs-125": {
      "$type": "dimension",
      "$value": "12.5px"
    },
    "fs-md": {
      "$type": "dimension",
      "$value": "13px",
      "$description": "Button and field label size."
    },
    "fs-135": {
      "$type": "dimension",
      "$value": "13.5px"
    },
    "fs-base": {
      "$type": "dimension",
      "$value": "14px",
      "$description": "Body. TITLE_LINE_PX = 21 is fs-base × lh-normal; the virtualizer's height model depends on it."
    },
    "fs-lg": {
      "$type": "dimension",
      "$value": "15px"
    },
    "fs-xl": {
      "$type": "dimension",
      "$value": "17px"
    },
    "fs-19": {
      "$type": "dimension",
      "$value": "19px"
    },
    "fs-20": {
      "$type": "dimension",
      "$value": "20px"
    },
    "fs-2xl": {
      "$type": "dimension",
      "$value": "24px"
    },
    "fs-34": {
      "$type": "dimension",
      "$value": "34px"
    },
    "fw-normal": {
      "$type": "fontWeight",
      "$value": 450,
      "$description": "Body weight is 450, not 400 — Inter at 400 is thin on dark surfaces."
    },
    "fw-medium": {
      "$type": "fontWeight",
      "$value": 500
    },
    "fw-semibold": {
      "$type": "fontWeight",
      "$value": 550
    },
    "fw-strong": {
      "$type": "fontWeight",
      "$value": 600
    },
    "fw-bold": {
      "$type": "fontWeight",
      "$value": 700
    },
    "lh-tight": {
      "$type": "number",
      "$value": 1.2
    },
    "lh-normal": {
      "$type": "number",
      "$value": 1.5,
      "$description": "Load-bearing: TITLE_LINE_PX = 21 = fs-base 14 × 1.5."
    },
    "ls-body": {
      "$type": "dimension",
      "$value": "-0.006em"
    },
    "ls-tight": {
      "$type": "dimension",
      "$value": "-0.01em"
    },
    "ls-none": {
      "$type": "dimension",
      "$value": "0em"
    },
    "ls-wide": {
      "$type": "dimension",
      "$value": "0.05em"
    },
    "ls-wider": {
      "$type": "dimension",
      "$value": "0.06em"
    }
  }
}
