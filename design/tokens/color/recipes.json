{
  "recipe": {
    "$description": "Reusable colour recipes. The build resolves each recipe with Culori for every scheme and product theme, so legacy WebViews receive concrete CSS colours instead of evaluating color-mix().",
    "$type": "color",
    "scheme": {
      "chrome-highlight": { "$value": "color-mix(in oklab, var(--text) 8%, transparent)" },
      "status-ok-subtle": { "$value": "color-mix(in oklab, var(--ok) 13%, transparent)" },
      "status-warn-subtle": { "$value": "color-mix(in oklab, var(--warn) 13%, transparent)" },
      "status-ok-bg": { "$value": "color-mix(in oklab, var(--ok) 15%, transparent)" },
      "status-warn-bg": { "$value": "color-mix(in oklab, var(--warn) 15%, transparent)" },
      "status-error-bg": { "$value": "color-mix(in oklab, var(--err) 15%, transparent)" },
      "status-info-bg": { "$value": "color-mix(in oklab, var(--info) 15%, transparent)" },
      "status-warn-border": { "$value": "color-mix(in oklab, var(--warn) 20%, transparent)" },
      "status-error-border": { "$value": "color-mix(in oklab, var(--err) 20%, transparent)" },
      "button-danger-hover-bg": { "$value": "color-mix(in oklab, var(--err) 12%, transparent)" },
      "skeleton-element-bg": { "$value": "color-mix(in oklab, var(--text) 13%, transparent)" },
      "artwork-error-bg": { "$value": "color-mix(in oklab, var(--err) 18%, transparent)" },
      "artwork-info-bg": { "$value": "color-mix(in oklab, var(--info) 18%, transparent)" },
      "swatch-highlight": { "$value": "color-mix(in oklab, var(--text) 16%, transparent)" },
      "redaction-line-bg": { "$value": "color-mix(in oklab, var(--withheld-fg) 25%, transparent)" },
      "protected-line-bg": { "$value": "color-mix(in oklab, var(--withheld-fg) 24%, transparent)" },
      "toolbar-glow-strong": { "$value": "color-mix(in oklab, var(--text) 3%, transparent)" },
      "toolbar-glow-soft": { "$value": "color-mix(in oklab, var(--text) 1%, transparent)" }
    },
    "theme": {
      "accent-hover": {
        "$value": "color-mix(in oklab, var(--accent) 88%, var(--accent-away))",
        "$description": "Solid accent hover moves one palette step away from its ink, never toward the active surface."
      },
      "resize-handle-hover": { "$value": "color-mix(in oklab, var(--accent) 12%, var(--panel))" },
      "device-icon-fg": { "$value": "color-mix(in oklab, var(--accent-2) 72%, var(--text))" },
      "control-focus-border": { "$value": "color-mix(in oklab, var(--accent) 45%, var(--border))" },
      "toast-ok-bg": { "$value": "color-mix(in oklab, var(--ok) 14%, var(--card))" },
      "toast-ok-border": { "$value": "color-mix(in oklab, var(--ok) 42%, var(--border))" },
      "toast-info-bg": { "$value": "color-mix(in oklab, var(--info) 14%, var(--card))" },
      "toast-info-border": { "$value": "color-mix(in oklab, var(--info) 42%, var(--border))" },
      "toast-warn-bg": { "$value": "color-mix(in oklab, var(--warn) 14%, var(--card))" },
      "toast-warn-border": { "$value": "color-mix(in oklab, var(--warn) 42%, var(--border))" },
      "toast-error-bg": { "$value": "color-mix(in oklab, var(--err) 14%, var(--card))" },
      "toast-error-border": { "$value": "color-mix(in oklab, var(--err) 42%, var(--border))" },
      "nav-hover-bg": { "$value": "color-mix(in oklab, var(--selected) 58%, transparent)" },
      "nav-current-border": { "$value": "color-mix(in oklab, var(--accent) 26%, var(--border))" },
      "nav-current-bg": { "$value": "color-mix(in oklab, var(--selected) 88%, var(--panel))" },
      "dock-current-bg": { "$value": "color-mix(in oklab, var(--accent) 9%, transparent)" },
      "reveal-overlay-bg": { "$value": "color-mix(in oklab, var(--card) 80%, transparent)" },
      "surface-warning-bg": { "$value": "color-mix(in oklab, var(--warn) 12%, var(--card))" },
      "surface-danger-bg": { "$value": "color-mix(in oklab, var(--err) 12%, var(--card))" },
      "button-secondary-hover-bg": { "$value": "color-mix(in oklab, var(--hover) 72%, var(--card))" },
      "button-secondary-pressed-border": { "$value": "color-mix(in oklab, var(--accent) 55%, var(--border))" },
      "danger-control-border": { "$value": "color-mix(in oklab, var(--err) 38%, var(--border))" },
      "update-bg": { "$value": "color-mix(in oklab, var(--card) 88%, var(--selected))" },
      "update-available-bg": { "$value": "color-mix(in oklab, var(--selected) 72%, var(--card))" },
      "skeleton-card-bg": { "$value": "color-mix(in oklab, var(--card) 88%, transparent)" },
      "artwork-orbit-border": { "$value": "color-mix(in oklab, var(--accent) 20%, transparent)" },
      "artwork-glow-bg": { "$value": "color-mix(in oklab, var(--accent) 18%, transparent)" },
      "quick-row-hover-bg": { "$value": "color-mix(in oklab, var(--card) 94%, var(--accent))" },
      "quick-row-selected-border": { "$value": "color-mix(in oklab, var(--accent) 74%, var(--border))" },
      "swatch-border": { "$value": "color-mix(in oklab, var(--text) 18%, var(--border))" },
      "inspector-bg-fallback": { "$value": "color-mix(in oklab, var(--panel) 97%, var(--accent))" },
      "inspector-glow": { "$value": "color-mix(in oklab, var(--accent) 12%, transparent)" },
      "chrome-frosted": { "$value": "color-mix(in oklab, var(--panel) 72%, transparent)" },
      "app-frosted": { "$value": "color-mix(in oklab, var(--bg) 84%, transparent)" }
    }
  }
}
