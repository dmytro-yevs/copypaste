{
  "elevation": {
    "$description": "Dark shadow ramp: Tailwind v4's shadow-xs / shadow-md / shadow-xl geometry, at the higher alphas a dark surface needs for the shadow to be visible at all.",
    "$type": "shadow",
    "sh1": {
      "$value": {
        "color": "oklch(0 0 0 / 0.4)",
        "offsetX": "0",
        "offsetY": "1px",
        "blur": "2px"
      },
      "$description": "Tailwind `shadow-xs`. Resting lift: a raised control, a row."
    },
    "sh2": {
      "$value": {
        "color": "oklch(0 0 0 / 0.5)",
        "offsetX": "0",
        "offsetY": "4px",
        "blur": "12px",
        "spread": "-2px"
      },
      "$description": "Tailwind `shadow-md`. Popover, dropdown, toast."
    },
    "sh3": {
      "$value": {
        "color": "oklch(0 0 0 / 0.6)",
        "offsetX": "0",
        "offsetY": "20px",
        "blur": "40px",
        "spread": "-12px"
      },
      "$description": "Tailwind `shadow-xl`. Dialog."
    }
  }
}
