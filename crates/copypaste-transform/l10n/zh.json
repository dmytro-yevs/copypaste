    "case.upper": {
      "name": "大写",
      "description": "按完整的 Unicode 规则将所有字母转换为大写。",
      "params": {
        "locale": {
          "label": "语言规则",
          "options": {
            "invariant": "与语言无关",
            "system": "设备语言"
          }
        }
      }
    },
    "case.lower": {
      "name": "小写",
      "description": "按完整的 Unicode 规则将所有字母转换为小写。",
      "params": {
        "locale": {
          "label": "语言规则",
          "options": {
            "invariant": "与语言无关",
            "system": "设备语言"
          }
        }
      }
    },
    "case.title": {
      "name": "标题格式",
      "description": "将单词首字母大写；标题样式会让短词保持小写。",
      "params": {
        "style": {
          "label": "样式",
          "options": {
            "headline": "标题",
            "all_words": "每个单词"
          }
        },
        "keep_acronyms": {
          "label": "保留缩写词"
        }
      }
    },
    "case.sentence": {
      "name": "句子格式",
      "description": "将每个句子的第一个词首字母大写，其余转为小写。",
      "params": {
