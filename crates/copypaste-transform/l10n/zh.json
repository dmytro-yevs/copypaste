          "label": "保留缩写词"
        }
      }
    },
    "case.pascal": {
      "name": "PascalCase",
      "description": "将单词连接成每个词首字母大写的标识符。",
      "params": {
        "per_line": {
          "label": "逐行转换"
        },
        "keep_acronyms": {
          "label": "保留缩写词"
        }
      }
    },
    "case.snake": {
      "name": "snake_case",
      "description": "用下划线连接小写单词。",
