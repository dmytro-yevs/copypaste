{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://copypaste.invalid/native-parity-evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "platform",
    "environment",
    "os_version",
    "architecture",
    "source",
    "scenario",
    "assertions",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "platform": { "enum": ["macos", "android", "windows"] },
    "environment": {
      "enum": ["hosted-runner", "emulator", "physical-device"]
    },
    "os_version": { "type": "string", "minLength": 1, "maxLength": 160 },
    "architecture": { "type": "string", "minLength": 1, "maxLength": 80 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "run_id"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "elapsed_ms", "budget_ms"],
      "properties": {
        "name": {
          "enum": ["native-launch", "release-webview-ready", "windows-installed-release"]
        },
        "elapsed_ms": { "type": "integer", "minimum": 0 },
        "budget_ms": { "type": "integer", "minimum": 1 }
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "installed app launched",
          "native accessibility tree is non-empty",
          "signed release app launched",
          "WebView accessibility content painted",
          "release smoke assertions passed",
          "installer integrity passed",
          "installed sidecar launched",
          "named-pipe and clipboard passed",
          "update feed contract matched signing mode",
          "in-place update passed",
          "uninstall passed"
        ]
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "sha256", "bytes"],
        "properties": {
          "kind": {
            "enum": [
              "screenshot",
              "accessibility",
              "measurement",
              "test-log",
              "diagnostic-log"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
          },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 1 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "type": "object", "properties": { "platform": { "const": "macos" } } },
      "then": {
        "type": "object",
        "properties": {
          "environment": { "const": "hosted-runner" },
          "scenario": {
            "type": "object",
            "properties": {
              "name": { "const": "native-launch" },
              "budget_ms": { "const": 3000 }
            }
          },
          "assertions": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "allOf": [
              { "contains": { "const": "installed app launched" } },
              { "contains": { "const": "native accessibility tree is non-empty" } }
            ]
          }
        }
      }
    },
    {
      "if": { "type": "object", "properties": { "platform": { "const": "android" } } },
      "then": {
        "type": "object",
        "properties": {
          "scenario": {
            "type": "object",
            "properties": {
              "name": { "const": "release-webview-ready" },
              "budget_ms": { "const": 115000 }
            }
          },
          "assertions": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "allOf": [
              { "contains": { "const": "signed release app launched" } },
              { "contains": { "const": "WebView accessibility content painted" } },
              { "contains": { "const": "release smoke assertions passed" } }
            ]
          }
        }
      }
    },
    {
      "if": { "type": "object", "properties": { "platform": { "const": "windows" } } },
      "then": {
        "type": "object",
        "properties": {
          "environment": { "const": "hosted-runner" },
          "scenario": {
            "type": "object",
            "properties": {
              "name": { "const": "windows-installed-release" },
              "budget_ms": { "const": 30000 }
            }
          },
          "assertions": {
            "type": "array",
            "minItems": 7,
            "maxItems": 7,
            "allOf": [
              { "contains": { "const": "installer integrity passed" } },
              { "contains": { "const": "installed app launched" } },
              { "contains": { "const": "installed sidecar launched" } },
              { "contains": { "const": "named-pipe and clipboard passed" } },
              { "contains": { "const": "update feed contract matched signing mode" } },
              { "contains": { "const": "in-place update passed" } },
              { "contains": { "const": "uninstall passed" } }
            ]
          }
        }
      }
    }
  ]
}
