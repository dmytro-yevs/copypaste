{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CopyPaste",
  "identifier": "com.copypaste.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "CopyPaste",
        "width": 420,
        "height": 600,
        "minWidth": 360,
        "minHeight": 400,
        "resizable": false,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": true,
        "skipTaskbar": true,
        "visible": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Clipboard history that stays on your machine.",
    "icon": [
      "icons/icon.png"
    ]
  }
}
