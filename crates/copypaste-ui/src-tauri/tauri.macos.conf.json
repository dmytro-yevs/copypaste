{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CopyPaste",
        "width": 1000,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "alwaysOnTop": false,
        "decorations": true,
        "transparent": false,
        "shadow": true,
        "center": true,
        "skipTaskbar": true,
        "visible": true,
        "dragDropEnabled": false,
        "contentProtected": true
      }
    ]
  },
  "bundle": {
    "targets": [
      "app",
      "dmg"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
