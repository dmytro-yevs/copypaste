{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CopyPaste",
        "width": 420,
        "height": 600,
        "minWidth": 360,
        "minHeight": 400,
        "resizable": false,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": true,
        "skipTaskbar": true,
        "visible": true,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "targets": [
      "app",
      "dmg"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
