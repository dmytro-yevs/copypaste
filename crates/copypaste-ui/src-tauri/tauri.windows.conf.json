{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CopyPaste",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 460,
        "resizable": true,
        "alwaysOnTop": false,
        "decorations": true,
        "transparent": false,
        "shadow": true,
        "center": true,
        "skipTaskbar": false,
        "visible": true,
        "dragDropEnabled": false,
        "contentProtected": true
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "publisher": "CopyPaste",
    "homepage": "https://github.com/dmytro-yevs/copypaste",
    "copyright": "Copyright © 2026 CopyPaste contributors",
    "targets": [
      "nsis"
    ],
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "startMenuFolder": "CopyPaste"
      }
    }
  }
}
