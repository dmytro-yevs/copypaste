{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/copypaste",
      "binaries/copypaste-daemon"
    ],
    "windows": {
      "signCommand": {
        "cmd": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "__WINDOWS_SIGN_SCRIPT__",
          "%1"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "__TAURI_UPDATER_PUBLIC_KEY__",
      "endpoints": [
        "__TAURI_UPDATER_ENDPOINT__"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
