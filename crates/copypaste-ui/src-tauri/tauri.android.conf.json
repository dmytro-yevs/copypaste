{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.copypaste.app",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CopyPaste",
        "visible": true,
        "dragDropEnabled": false
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "npm run build:android"
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  },
  "bundle": {
    "android": {
      "minSdkVersion": 24,
      "versionCode": 200000032,
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
