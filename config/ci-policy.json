{
  "schema": 1,
  "required_jobs": {
    "ci.yml": {
      "compositor-runtime-metadata": "Compositor runtime metadata",
      "compositor-runtime-producer": "Compositor runtime producer",
      "rust-and-supabase": "rust-and-supabase",
      "macos-core": "macOS Rust capabilities",
      "windows-core": "Windows Rust capabilities",
      "optional-modules": "Optional modules (${{ matrix.name }})",
      "flutter-foundation": "Flutter foundation (${{ matrix.name }})",
      "linux-native-fixtures": "Linux native fixtures (${{ matrix.architecture }})",
      "linux-mutter-bridges": "Mutter ${{ matrix.mutter }} bridge (${{ matrix.architecture }})",
      "linux-pr-release-candidate": "Linux release candidate (${{ matrix.architecture }})",
      "linux-package-fixtures": "Linux package fixtures (${{ matrix.architecture }})",
      "changes": "Select required validation",
      "required": "CI required",
      "flutter-static": "Flutter static checks"
    },
    "release.yml": {
      "preflight": "preflight",
      "linux-native-bootstrap": "Run exact staged Linux native qualification",
      "qualification-supabase": "Build Linux supabase module",
      "qualification-semantic-search": "Build Linux semantic-search module",
      "qualification-ocr": "Build Linux ocr module",
      "linux-native-current": "Qualify current Linux artifacts",
      "macos": "macos",
      "macos-regression": "macos-regression",
      "android": "android",
      "windows": "windows",
      "linux": "Linux build (${{ matrix.architecture }})",
      "compositor-runtime-build": "Build opt-in compositor runtime companions",
      "compositor-runtime-external": "Verify staged compositor runtime companions",
      "compositor-runtime-public": "Sign and bind opt-in compositor runtime companions",
      "linux-full-parity-evidence": "Linux full parity evidence gate",
      "qualify": "qualify",
      "publish": "publish",
      "release-required": "Release qualification required",
      "policy": "Release CI policy"
    },
    "codeql-scheduled.yml": {
      "analyze-no-build": "analyze-no-build",
      "analyze-swift": "analyze-swift",
      "analyze-cpp": "analyze-cpp"
    },
    "linux-native-qualification.yml": {
      "source": "Verify exact artifact sources",
      "scenario": "${{ matrix.architecture }} ${{ matrix.desktop }} ${{ matrix.session }}",
      "evidence": "Assemble verified Linux native qualification"
    },
    "ci-configuration.yml": {
      "validate": "CI Policy Gate"
    },
    "provider-module.yml": {
      "preflight": "preflight",
      "desktop": "desktop",
      "android": "android",
      "android-native": "android-native",
      "publish": "publish"
    },
    "ocr-module.yml": {
      "preflight": "preflight",
      "desktop": "desktop",
      "android": "android",
      "android-native": "android-native",
      "publish": "publish"
    }
  },
  "required_dependencies": {
    "ci.yml": {
      "required": [
        "changes",
        "flutter-static",
        "compositor-runtime-metadata",
        "compositor-runtime-producer",
        "rust-and-supabase",
        "macos-core",
        "windows-core",
        "optional-modules",
        "flutter-foundation",
        "linux-native-fixtures",
        "linux-mutter-bridges",
        "linux-pr-release-candidate",
        "linux-package-fixtures"
      ]
    },
    "release.yml": {
      "linux-native-current": [
        "preflight",
        "policy",
        "linux",
        "compositor-runtime-public",
        "qualification-supabase",
        "qualification-semantic-search",
        "qualification-ocr"
      ],
      "linux-full-parity-evidence": [
        "preflight",
        "policy",
        "linux",
        "compositor-runtime-public",
        "linux-native-current"
      ],
      "qualify": [
        "preflight",
        "policy",
        "macos",
        "macos-regression",
        "android",
        "windows",
        "linux",
        "compositor-runtime-public",
        "linux-full-parity-evidence"
      ],
      "publish": [
        "preflight",
        "qualify"
      ],
      "release-required": [
        "preflight",
        "qualify",
        "linux-native-bootstrap"
      ]
    }
  },
  "qualification_guards": {
    "ci.yml": {
      "required": "${{ always() }}"
    },
    "release.yml": {
      "linux-native-current": "${{ !cancelled() && needs.preflight.result == 'success' && needs.policy.result == 'success' && needs.preflight.outputs.reuse_qualified != 'true' && needs.preflight.outputs.linux_qualification_only != 'true' && needs.preflight.outputs.linux_required == 'true' && inputs.linux_evidence_run_id == '' && (needs.linux.result == 'success' || inputs.linux_artifact_run_id != '') && needs.compositor-runtime-public.result == 'success' && (needs.qualification-supabase.result == 'success' || inputs.supabase_module_run_id != '') && (needs.qualification-semantic-search.result == 'success' || inputs.semantic_search_module_run_id != '') && (needs.qualification-ocr.result == 'success' || inputs.ocr_module_run_id != '') }}",
      "linux-full-parity-evidence": "${{ !cancelled() && needs.preflight.result == 'success' && needs.policy.result == 'success' && needs.preflight.outputs.reuse_qualified != 'true' && needs.preflight.outputs.linux_qualification_only != 'true' && (needs.linux-native-current.result == 'success' || inputs.linux_evidence_run_id != '') && needs.preflight.outputs.linux_required == 'true' && (needs.linux.result == 'success' || needs.preflight.outputs.linux_artifact_run_id != github.run_id) && (needs.preflight.outputs.compositor_runtime_required != 'true' || needs.compositor-runtime-public.result == 'success') }}",
      "qualify": "${{ !cancelled() && needs.preflight.result == 'success' && needs.policy.result == 'success' && (needs.preflight.outputs.reuse_qualified == 'true' || (needs.macos.result == 'success' && needs.macos-regression.result == 'success' && needs.android.result == 'success' && needs.windows.result == 'success' && (needs.preflight.outputs.linux_required != 'true' || ((needs.linux.result == 'success' || needs.preflight.outputs.linux_artifact_run_id != github.run_id) && needs.linux-full-parity-evidence.result == 'success' && (needs.preflight.outputs.compositor_runtime_required != 'true' || needs.compositor-runtime-public.result == 'success'))))) }}",
      "publish": "${{ !cancelled() && needs.preflight.result == 'success' && needs.qualify.result == 'success' && needs.preflight.outputs.publish == 'true' }}",
      "release-required": "${{ always() }}"
    }
  },
  "required_concurrency": {
    "release.yml": {
      "group": "production-release-${{ github.sha }}",
      "cancel-in-progress": false,
      "queue": "max"
    },
    "provider-module.yml": {
      "group": "provider-module-${{ inputs.module }}${{ inputs.linux_only && format('-qualification-{0}', github.run_id) || '' }}",
      "cancel-in-progress": false,
      "queue": "max"
    },
    "ocr-module.yml": {
      "group": "ocr-module-release${{ inputs.linux_only && format('-qualification-{0}', github.run_id) || '' }}",
      "cancel-in-progress": false,
      "queue": "max"
    },
    "linux-native-qualification.yml": {
      "group": "linux-native-qualification-${{ inputs.artifact_run_id }}",
      "cancel-in-progress": false,
      "queue": "max"
    },
    "module-marketplace.yml": {
      "group": "module-marketplace",
      "cancel-in-progress": false,
      "queue": "max"
    }
  },
  "required_job_concurrency": {
    "release.yml": {
      "publish": {
        "group": "copypaste-stable-publication",
        "cancel-in-progress": false,
        "queue": "max"
      }
    }
  },
  "artifact_retention_days": {
    "ci-metrics.yml": {
      "report": 3
    },
    "ci.yml": {
      "linux-pr-release-candidate": 3
    },
    "compositor-runtime.yml": {
      "build": 7
    },
    "linux-experimental.yml": {
      "linux-pr-release-candidate": 3
    },
    "linux-native-qualification.yml": {
      "scenario": 3,
      "evidence": 90
    },
    "ocr-module.yml": {
      "desktop": 7,
      "android": 7,
      "android-native": 90
    },
    "provider-module.yml": {
      "desktop": 7,
      "android": 7,
      "android-native": 90
    },
    "release.yml": {
      "macos": 7,
      "android": 7,
      "windows": 7,
      "linux": 90,
      "compositor-runtime-public": 7,
      "qualify": 90
    },
    "sms-codes-module.yml": {
      "android": 3
    },
    "supabase-module.yml": {
      "desktop": 3,
      "android": 3
    }
  }
}
